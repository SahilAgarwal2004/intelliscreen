# IntelliScreen Environment Configuration
# Copy this file to .env and adjust variables as required.

# Environment & Logging
INTELLISCREEN_ENV=development
INTELLISCREEN_LOG_LEVEL=INFO
INTELLISCREEN_DEBUG=false

# Frame Ingestion & Vision Sampling
INTELLISCREEN_VISION_TARGET_FPS=10
INTELLISCREEN_VISION_FRAME_WIDTH=640
INTELLISCREEN_VISION_FRAME_HEIGHT=480
INTELLISCREEN_VISION_OBJECT_DETECTION_STRIDE=3

# Head Pose & Gaze Deviation Thresholds (Degrees)
INTELLISCREEN_GAZE_YAW_THRESHOLD=25.0
INTELLISCREEN_GAZE_PITCH_THRESHOLD=20.0
INTELLISCREEN_HEAD_YAW_THRESHOLD=30.0
INTELLISCREEN_HEAD_PITCH_THRESHOLD=25.0

# Temporal Duration Thresholds (Seconds)
INTELLISCREEN_TEMPORAL_NORMAL_LOOK_AWAY_MAX_SEC=2.5
INTELLISCREEN_TEMPORAL_SUSPICIOUS_LOOK_AWAY_MIN_SEC=4.0
INTELLISCREEN_TEMPORAL_FACE_ABSENCE_ALERT_SEC=3.0
INTELLISCREEN_TEMPORAL_PHONE_PRESENCE_ALERT_SEC=2.0
INTELLISCREEN_TEMPORAL_SLIDING_WINDOW_SEC=30.0

# Suspicion Scoring Thresholds (0 - 100)
INTELLISCREEN_SCORING_LOW_THRESHOLD=30.0
INTELLISCREEN_SCORING_MEDIUM_THRESHOLD=60.0
INTELLISCREEN_SCORING_HIGH_THRESHOLD=80.0

# NLP & Speech-to-Text
INTELLISCREEN_NLP_EMBEDDING_MODEL=all-MiniLM-L6-v2
INTELLISCREEN_STT_MODEL_SIZE=base.en
INTELLISCREEN_STT_DEVICE=cpu
